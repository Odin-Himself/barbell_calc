import 'package:flutter/material.dart';


void main() {
  runApp(const BarbellApp());
}


// =======================
// ЛОГИКА РАСЧЕТА
// =======================

class CalculationResult {

  final String text;
  final List<double> discs;

  CalculationResult(this.text, this.discs);
}


CalculationResult calculateDiscs(double totalWeight) {

  const double barbellWeight = 20;
  const double lockWeight = 2.5;

  List<double> discWeights = [
    25,
    20,
    15,
    10,
    5,
    2.5,
    1.25,
    1,
    0.5
  ];


  double weightOnEachSide =
      (totalWeight - barbellWeight - 2 * lockWeight) / 2;


  if (weightOnEachSide < 0) {
    return CalculationResult(
        "Недостаточный вес",
        []
    );
  }



  List<double> combination = [];


  double remaining = weightOnEachSide;


  // большие диски
  for (double disc in discWeights.sublist(0,4)) {

    while (remaining >= disc) {

      combination.add(disc);
      remaining -= disc;

    }
  }


  // маленькие диски
  for (double disc in discWeights.sublist(4)) {

    while (remaining >= disc) {

      combination.add(disc);
      remaining -= disc;

    }
  }



  double total =
      2 * (combination.reduce((a,b)=>a+b)
      + lockWeight)
      + barbellWeight;



  String left =
      combination.reversed.join(" ");

  String right =
      combination.join(" ");



  String result =
      "$lockWeight = $left = $barbellWeight = $right = $lockWeight   [${total.round()}]";


  return CalculationResult(result, combination);

}



// =======================
// UI
// =======================


class BarbellApp extends StatelessWidget {

  const BarbellApp({super.key});


  @override
  Widget build(BuildContext context) {

    return MaterialApp(

      debugShowCheckedModeBanner:false,

      home: CalculatorPage(),

    );

  }

}



class CalculatorPage extends StatefulWidget {

  const CalculatorPage({super.key});


  @override
  State<CalculatorPage> createState() =>
      _CalculatorPageState();

}




class _CalculatorPageState 
extends State<CalculatorPage>{


  final TextEditingController controller =
      TextEditingController();


  String result="";

  List<double> discs=[];



  void calculate(){

    double? weight =
        double.tryParse(controller.text);


    if(weight==null){

      setState((){

        result="Введите число";

      });

      return;
    }


    CalculationResult r =
        calculateDiscs(weight);


    setState((){

      result=r.text;

      discs=r.discs;

    });


  }





  Widget discImage(double disc){


    String name =
        disc.toString()
        .replaceAll(".","_");


    return Image.asset(

      "assets/disk_${name}.png",

      height:120,

    );


  }





@override
Widget build(BuildContext context){


return Scaffold(


body: SafeArea(

child: Column(

children:[


const SizedBox(height:20),


const Text(

"Введите вес на штанге:",

style:TextStyle(
fontSize:30,
color:Colors.red
),

),



TextField(

controller:controller,

keyboardType:
TextInputType.number,

textAlign:TextAlign.center,

style:
const TextStyle(fontSize:40),

),



ElevatedButton(

onPressed:calculate,

child:
const Text(
"Ввод",
style:
TextStyle(fontSize:30),
),

),



const SizedBox(height:20),



Text(

result,

textAlign:TextAlign.center,

style:
const TextStyle(
fontSize:18
),

),



Expanded(

child:

SingleChildScrollView(

scrollDirection:
Axis.horizontal,


child:Row(

mainAxisAlignment:
MainAxisAlignment.center,


children:

discs.map(

(d)=>discImage(d)

).toList(),

),


),

)


],

),

),

);

}

}